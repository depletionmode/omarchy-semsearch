#!/usr/bin/env python3
"""Command-line client for semsearchd: semsearch status | rescan | [-w] [-k KIND] <query>

-w also matches the literal words and file paths.
-k narrows the hits to one kind: text, code or image."""
import json
import os
import socket
import sys

args = sys.argv[1:]
words = kind = None
while args[:1] in (["-w"], ["-k"]):
    if args.pop(0) == "-w":
        words = True
    else:
        kind = args.pop(0)
arg = " ".join(args) or "status"
req = {"id": 1, "op": arg}
if arg not in ("status", "rescan"):
    req = {"id": 1, "op": "search", "q": arg, "words": words, "kind": kind}
s = socket.socket(socket.AF_UNIX)
s.connect(os.environ["XDG_RUNTIME_DIR"] + "/semsearch.sock")
s.sendall((json.dumps(req) + "\n").encode())
resp = json.loads(s.makefile().readline())
for hit in resp.get("hits", []):
    where = " p.%d" % hit["page"] if hit["page"] else ":%d" % hit["line"] if hit["line"] else ""
    print("%-7s %s/%s%s" % (hit["why"], hit["dir"], hit["name"], where))
print(resp.get("error") or resp["status"], file=sys.stderr)
