# --- Text -------------------------------------------------------------------


def windows(n, size=180, overlap=30):
    """Word spans (start, end) of overlapping passages covering n words."""
    spans = []
    start = 0
    while start < n:
        end = min(n, start + size)
        if n - end <= overlap:
            end = n  # a tail the next window would only repeat
        spans.append((start, end))
        if end == n:
            break
        start = end - overlap
    return spans


def query_terms(query):
    return [t for t in re.findall(r"\w+", query.lower()) if len(t) >= 2 and t not in STOPWORDS]


def is_match(word, terms):
    """Whether a word is one of the query's terms, or the rest of one still
    being typed. Never the other way round: "accountant" is not "account"."""
    w = word.lower()
    return any(w.startswith(t) for t in terms)


def snippet(text, terms, width=170):
    """HTML-escaped excerpt around the first matching word, matches in <b>."""
    words = text.split()
    parts = [re.match(r"^(\W*)(.*?)(\W*)$", w, re.S).groups() for w in words]
    hit = next((i for i, p in enumerate(parts) if terms and is_match(p[1], terms)), 0)

    start = end = hit
    used = 0
    # A third of the room before the match, the rest after it.
    while start > 0 and used + len(words[start - 1]) < width // 3:
        start -= 1
        used += len(words[start]) + 1
    while end < len(words) and used + len(words[end]) < width:
        used += len(words[end]) + 1
        end += 1

    out = []
    for pre, core, post in parts[start:end]:
        core_html = html.escape(core)
        if terms and core and is_match(core, terms):
            core_html = "<b>" + core_html + "</b>"
        out.append(html.escape(pre) + core_html + html.escape(post))
    return ("…" if start > 0 else "") + " ".join(out) + ("…" if end < len(words) else "")


# A line that starts a definition, in most of the languages worth indexing:
# a keyword at up to one level of indentation, a JS binding to a function, or
# a C-style header at the left margin.
DEFINITION = re.compile(
    r"^[ \t]{0,4}(?:(?:export|default|public|private|protected|static|async|pub|abstract|final|override|inline"
    r"|extern|unsafe)\s+)*(?:def|class|function\*?|fn|func|impl|struct|enum|trait|interface|type|module|proc"
    r"|macro|sub)\b"
    r"|^(?:export\s+)?(?:const|let|var)\s+\w+\s*=\s*(?:async\s*)?(?:\(|function\b|\w+\s*=>)"
    r"|^[A-Za-z_][\w \t*&:<>,\[\]]*\([^;{}]*\)\s*(?:const\s*)?\{?\s*$"
)
# Comments and decorators directly above a definition belong to it.
LEAD_IN = re.compile(r"^\s*(?:#|//|/\*|\*|@|--)")


def code_blocks(lines, merge=40, limit=80):
    """Spans (first, last) of 1-based line numbers, one per function-sized
    block: split at definitions, small neighbours merged, long ones windowed."""
    if not lines:
        return []
    starts = [0]
    for i, line in enumerate(lines):
        if i and DEFINITION.match(line):
            while i > starts[-1] + 1 and LEAD_IN.match(lines[i - 1]):
                i -= 1
            if i > starts[-1]:
                starts.append(i)

    merged = []
    for a, b in zip(starts, starts[1:] + [len(lines)]):
        if merged and b - merged[-1][0] <= merge:
            merged[-1] = (merged[-1][0], b)
        else:
            merged.append((a, b))

    spans = []
    for a, b in merged:
        if b - a <= limit:
            spans.append((a + 1, b))
        else:
            spans.extend((a + w0 + 1, a + w1) for w0, w1 in windows(b - a, size=60, overlap=10))
    return spans


# --- Extraction -------------------------------------------------------------

BBOX_PAGE = re.compile(r'<page width="([\d.]+)" height="([\d.]+)">(.*?)</page>', re.S)
BBOX_WORD = re.compile(
    r'<word xMin="([-\d.]+)" yMin="([-\d.]+)" xMax="([-\d.]+)" yMax="([-\d.]+)">(.*?)</word>', re.S
)


def parse_bbox(xhtml):
    """pdftotext -bbox output -> [{size: (w, h), words: [(text, x0, y0, x1, y1)]}]."""
    pages = []
    for width, height, body in BBOX_PAGE.findall(xhtml):
        words = [
            (html.unescape(text), float(x0), float(y0), float(x1), float(y1))
            for x0, y0, x1, y1, text in BBOX_WORD.findall(body)
        ]
        pages.append({"size": (float(width), float(height)), "words": words})
    return pages


def pdf_pages(path, first=None, last=None):
    cmd = ["pdftotext", "-bbox"]
    if first:
        cmd += ["-f", str(first), "-l", str(last or first)]
    out = subprocess.run(cmd + [path, "-"], capture_output=True, timeout=180).stdout
    return parse_bbox(out.decode("utf-8", "replace"))


def line_rects(words, size):
    """Merge consecutive words on one line into rects, as fractions of the page."""
    width, height = size
    rects = []
    for _, x0, y0, x1, y1 in words:
        if rects and abs(rects[-1][1] - y0) < 2 and x0 >= rects[-1][0]:
            rects[-1][2] = max(rects[-1][2], x1)
            rects[-1][3] = max(rects[-1][3], y1)
        else:
            rects.append([x0, y0, x1, y1])
    return [(x0 / width, y0 / height, (x1 - x0) / width, (y1 - y0) / height) for x0, y0, x1, y1 in rects]


def zipped_xml_words(path, member):
    with zipfile.ZipFile(path) as z:
        xml = z.read(member).decode("utf-8", "replace")
    return html.unescape(re.sub(r"<[^>]+>", " ", xml)).split()


def extract(path, max_pages):
    """-> [(page_number, [word, ...])]. Page 0 means the format has no pages."""
    ext = path.rsplit(".", 1)[-1].lower()
    if ext == "pdf":
        return [(i + 1, [w[0] for w in p["words"]]) for i, p in enumerate(pdf_pages(path, 1, max_pages))]
    if ext == "docx":
        return [(0, zipped_xml_words(path, "word/document.xml"))]
    if ext == "odt":
        return [(0, zipped_xml_words(path, "content.xml"))]
    # The first megabyte: a book is about that, and what is longer is a log.
    with open(path, "rb") as f:
        return [(0, f.read(1 << 20).decode("utf-8", "replace").split())]


def image_size(path):
    from PIL import Image

    with Image.open(path) as im:
        return im.size


def image_input(path):
    """An image as a /v1/embeddings input item, downscaled: the vision encoder
    resamples to its own resolution anyway, and a 24 MP photo is slow to ship."""
    from PIL import Image

    with Image.open(path) as im:
        im = im.convert("RGB")
        im.thumbnail((768, 768))
        buf = io.BytesIO()
        im.save(buf, "JPEG", quality=88)
    url = "data:image/jpeg;base64," + base64.b64encode(buf.getvalue()).decode()
    return {"content": [{"type": "image_url", "image_url": {"url": url}}]}


# --- Embedding --------------------------------------------------------------


class LlamaEmbedder:
    """EmbeddingGemma through a llama-server child, started lazily, stopped when idle.

    With vision=False only the text model is loaded, which is all a query or a
    document needs; the vision projector is twice its size."""

    def __init__(self, cfg, vision=False):
        self.cfg = cfg
        self.vision = vision
        self.lock = threading.Lock()
        self.proc = None
        self.port = 0
        self.active = 0
        self.last_used = 0.0
        self.started = threading.Event()
        if cfg["idle_unload_seconds"]:
            threading.Thread(target=self._reap, daemon=True).start()

    def _reap(self):
        """Unload once idle. Blocks, without waking, for as long as nothing is loaded."""
        idle = self.cfg["idle_unload_seconds"]
        while True:
            self.started.wait()
            self.started.clear()
            while self.loaded():
                time.sleep(max(1.0, self.last_used + idle + 1 - time.monotonic()))
                self.unload_if_idle()

    def loaded(self):
        return self.proc is not None and self.proc.poll() is None

    def _start(self):
        server = self.cfg["llama_server"]
        with socket.socket() as s:
            s.bind(("127.0.0.1", 0))
            self.port = s.getsockname()[1]
        # Two slots so a query never queues behind an indexing batch; the
        # context is split between them, 2048 tokens each.
        cmd = [server, "-m", self.cfg["model"], "--embedding", "--host", "127.0.0.1", "--port", str(self.port),
               "-ngl", str(self.cfg["gpu_layers"]), "-c", "4096", "-b", "2048", "-ub", "2048", "--parallel", "2"]
        if self.vision:
            cmd += ["--mmproj", self.cfg["mmproj"]]
        env = dict(os.environ, LD_LIBRARY_PATH=os.path.dirname(server))
        self.proc = subprocess.Popen(cmd, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        deadline = time.monotonic() + 90
        while time.monotonic() < deadline:
            if self.proc.poll() is not None:
                raise RuntimeError("llama-server exited with %s" % self.proc.returncode)
            try:
                urllib.request.urlopen("http://127.0.0.1:%d/health" % self.port, timeout=1)
                log("vision model loaded" if self.vision else "text model loaded")
                self.last_used = time.monotonic()
                self.started.set()
                return
            except OSError:
                time.sleep(0.1)
        raise RuntimeError("llama-server did not become ready")

    def _post(self, inputs):
        req = urllib.request.Request(
            "http://127.0.0.1:%d/v1/embeddings" % self.port,
            json.dumps({"input": inputs}).encode(),
            {"Content-Type": "application/json"},
        )
        data = json.load(urllib.request.urlopen(req, timeout=120))["data"]
        return [d["embedding"] for d in sorted(data, key=lambda d: d["index"])]

    def _one(self, item):
        # Dense tables can tokenize to more than a slot holds; halve until it fits.
        for _ in range(4):
            try:
                return self._post([item])[0]
            except urllib.error.HTTPError:
                if not isinstance(item, str):
                    break
                item = item[: len(item) // 2]
        raise RuntimeError("input could not be embedded")

    def embed(self, inputs):
        """Unit vectors for a list of strings and/or image_input() items."""
        with self.lock:
            if not self.loaded():
                self._start()
            self.active += 1
        try:
            try:
                vectors = self._post(inputs)
            except urllib.error.HTTPError:
                vectors = [self._one(item) for item in inputs]
        finally:
            with self.lock:
                self.active -= 1
                self.last_used = time.monotonic()
        m = np.asarray(vectors, dtype=np.float32)
        return m / np.linalg.norm(m, axis=1, keepdims=True)

    def unload_if_idle(self):
        idle = self.cfg["idle_unload_seconds"]
        with self.lock:
            if idle and self.loaded() and not self.active and time.monotonic() - self.last_used > idle:
                self._stop()
                log("%s model unloaded after %ds idle" % ("vision" if self.vision else "text", idle))

    def _stop(self):
        if self.proc:
            self.proc.terminate()
            try:
                self.proc.wait(10)
            except subprocess.TimeoutExpired:
                self.proc.kill()
            self.proc = None

    def stop(self):
        with self.lock:
            self._stop()


# --- Index ------------------------------------------------------------------

SCHEMA = """
CREATE TABLE IF NOT EXISTS meta(key TEXT PRIMARY KEY, value TEXT);
CREATE TABLE IF NOT EXISTS files(id INTEGER PRIMARY KEY, path TEXT UNIQUE, mtime REAL, size INTEGER, pages INTEGER);
-- kind is TEXT, IMAGE or CODE. w0 and w1 are the passage's word span on its
-- page for TEXT, and its first and last line for CODE.
-- hash identifies the embedded text, so identical passages are embedded once.
CREATE TABLE IF NOT EXISTS chunks(id INTEGER PRIMARY KEY, file_id INTEGER, kind INTEGER, page INTEGER,
                                  w0 INTEGER, w1 INTEGER, text TEXT, vec BLOB, hash BLOB);
"""
INDEXES = """
CREATE INDEX IF NOT EXISTS chunks_file ON chunks(file_id);
CREATE INDEX IF NOT EXISTS chunks_hash ON chunks(hash);
"""

# No stemming: a word match means the word itself. Related forms are the
# embedding's job, and are then labelled as a match by meaning.
FTS = "CREATE VIRTUAL TABLE fts USING fts5(title, body, tokenize='unicode61')"


class Index:
    def __init__(self, db, embedder, image_embedder=None, cfg=DEFAULTS):
        self.db = db
        self.embedder = embedder
        self.image_embedder = image_embedder or embedder
        self.cfg = cfg
        self.lock = threading.RLock()
        self.text_extensions = set(cfg["extensions"])
        self.image_extensions = set(cfg["image_extensions"])
        self.code_extensions = set(cfg["code_extensions"])
        self.ids = np.zeros(0, dtype=np.int64)
        self.kinds = np.zeros(0, dtype=np.int8)
        self.matrix = np.zeros((0, 1), dtype=np.float32)
        self.means = {}
        self.stale = True
        self.loaded_at = 0.0
        with self.lock, self.db:
            self.db.executescript(SCHEMA)
            # Bring an index made by an earlier version up to date.
            columns = {row[1] for row in self.db.execute("PRAGMA table_info(chunks)")}
            if "image" in columns:
                self.db.execute("ALTER TABLE chunks RENAME COLUMN image TO kind")
            if "hash" not in columns:
                self.db.execute("ALTER TABLE chunks ADD COLUMN hash BLOB")
            self.db.executescript(INDEXES)
            self._ensure_fts()

    def kind_of(self, path):
        """TEXT, IMAGE or CODE by extension; None for a file that is not indexed."""
        ext = path.rsplit(".", 1)[-1].lower()
        if ext in self.image_extensions:
            return IMAGE
        if ext in self.code_extensions:
            return CODE
        return TEXT if ext in self.text_extensions else None

    def _ensure_fts(self):
        """Create the word index, or rebuild it from the stored passages when
        it was made by a version that tokenized differently."""
        row = self.db.execute("SELECT value FROM meta WHERE key='fts'").fetchone()
        if row and row[0] == FTS:
            return
        self.db.execute("DROP TABLE IF EXISTS fts")
        self.db.execute(FTS)
        first = set()
        for chunk_id, file_id, path, text in self.db.execute(
            "SELECT c.id, c.file_id, f.path, c.text FROM chunks c JOIN files f ON f.id = c.file_id ORDER BY c.id"
        ).fetchall():
            self._add_words(chunk_id, path if file_id not in first else "", text)
            first.add(file_id)
        self.db.execute("INSERT OR REPLACE INTO meta VALUES('fts', ?)", (FTS,))

    def _add_words(self, chunk_id, path, text):
        # The path is searchable too, on a file's first passage only so a
        # folder name matches each document in it once.
        self.db.execute(
            "INSERT INTO fts(rowid, title, body) VALUES(?,?,?)", (chunk_id, path.removeprefix(HOME), text)
        )

    def reset_if_model_changed(self, model):
        with self.lock, self.db:
            row = self.db.execute("SELECT value FROM meta WHERE key='model'").fetchone()
            if row and row[0] != model:
                log("model changed, rebuilding the index")
                for table in ("files", "chunks", "fts"):
                    self.db.execute("DELETE FROM " + table)
                self.stale = True
            self.db.execute("INSERT OR REPLACE INTO meta VALUES('model', ?)", (model,))

    def known_files(self):
        with self.lock:
            return {p: (m, s) for p, m, s in self.db.execute("SELECT path, mtime, size FROM files")}

    def stats(self):
        with self.lock:
            files = self.db.execute("SELECT count(*) FROM files").fetchone()[0]
            chunks = self.db.execute("SELECT count(*) FROM chunks").fetchone()[0]
        return {"files": files, "chunks": chunks}

    def index_file(self, path):
        st = os.stat(path)
        with self.lock:
            row = self.db.execute("SELECT mtime, size FROM files WHERE path=?", (path,)).fetchone()
        if row == (st.st_mtime, st.st_size):
            return

        name = os.path.basename(path)
        title = name.rsplit(".", 1)[0]
        kind = self.kind_of(path)
        pages = []
        passages = []  # (page, w0, w1, text)
        vectors = []
        hashes = []
        if kind == IMAGE:
            # One vector for the picture itself. Icons and spacers are noise.
            if min(image_size(path)) >= 64:
                passages = [(0, 0, 0, "")]
                vectors = list(self.image_embedder.embed([image_input(path)]))
                hashes = [None]
        else:
            if kind == CODE:
                with open(path, encoding="utf-8", errors="replace") as f:
                    lines = f.read().split("\n")
                # A line this long is minified or generated, not written.
                if max(map(len, lines)) <= 1000:
                    for first, last in code_blocks(lines):
                        block = "\n".join(lines[first - 1 : last])
                        if block.strip():
                            passages.append((0, first, last, block))
                title = name  # the model card's code documents are titled by file name
            else:
                pages = extract(path, self.cfg["max_pages"])
                for page, words in pages:
                    for w0, w1 in windows(len(words)):
                        passages.append((page, w0, w1, " ".join(words[w0:w1])))
            # A passage already embedded elsewhere (a copy of the file, another
            # worktree of the repository) keeps the vector it has.
            # The model reads about 2,000 tokens. Prose passages are far
            # shorter; a "passage" of paths, base64 or one-line data is not,
            # and is cut rather than sent whole. At the three characters a
            # token that such text manages, 4,000 characters still fit.
            prompts = [DOC_PROMPT.format(title=title, text=p[3][:4000]) for p in passages]
            hashes = [hashlib.blake2b(prompt.encode(), digest_size=12).digest() for prompt in prompts]
            vectors = [None] * len(prompts)
            with self.lock:
                for i, digest in enumerate(hashes):
                    row = self.db.execute("SELECT vec FROM chunks WHERE hash=? LIMIT 1", (digest,)).fetchone()
                    if row:
                        vectors[i] = np.frombuffer(row[0], dtype=np.float32)
            missing = [i for i, vec in enumerate(vectors) if vec is None]
            for start in range(0, len(missing), 8):
                batch = missing[start : start + 8]
                for i, vec in zip(batch, self.embedder.embed([prompts[i] for i in batch])):
                    vectors[i] = vec

        with self.lock, self.db:
            self._delete(path)
            file_id = self.db.execute(
                "INSERT INTO files(path, mtime, size, pages) VALUES(?,?,?,?)",
                (path, st.st_mtime, st.st_size, len(pages) if pages and pages[0][0] else 0),
            ).lastrowid
            for n, ((page, w0, w1, text), vec, digest) in enumerate(zip(passages, vectors, hashes)):
                chunk_id = self.db.execute(
                    "INSERT INTO chunks(file_id, kind, page, w0, w1, text, vec, hash) VALUES(?,?,?,?,?,?,?,?)",
                    (file_id, kind, page, w0, w1, text, vec.astype(np.float32).tobytes(), digest),
                ).lastrowid
                self._add_words(chunk_id, path if n == 0 else "", text)
            self.stale = True

    def _delete(self, path):
        row = self.db.execute("SELECT id FROM files WHERE path=?", (path,)).fetchone()
        if not row:
            return
        self.db.execute("DELETE FROM fts WHERE rowid IN (SELECT id FROM chunks WHERE file_id=?)", row)
        self.db.execute("DELETE FROM chunks WHERE file_id=?", row)
        self.db.execute("DELETE FROM files WHERE id=?", row)
        self.stale = True

    def remove_file(self, path):
        with self.lock, self.db:
            self._delete(path)

    def _vectors(self):
        with self.lock:
            # Reloading reads every vector, which grows with the index. While
            # files are still being indexed a search may use a matrix that is
            # a little behind, by at most about a second per 5,000 rows.
            if self.stale and time.monotonic() - self.loaded_at >= len(self.ids) / 5000:
                rows = self.db.execute("SELECT id, kind, vec FROM chunks").fetchall()
                self.ids = np.array([r[0] for r in rows], dtype=np.int64)
                self.kinds = np.array([r[1] for r in rows], dtype=np.int8)
                matrix = np.frombuffer(b"".join(r[2] for r in rows), dtype=np.float32).reshape(len(rows), -1).copy()
                # Every embedding shares a large common component (the mean
                # vector has norm ~0.8), which leaves unrelated passages at a
                # cosine of ~0.55 and real matches barely above them. Taking
                # the mean out, per kind, is what makes a threshold meaningful.
                # With only a few rows the mean is just those rows, so it stays.
                self.means = {}
                for kind in (TEXT, IMAGE, CODE):
                    where = self.kinds == kind
                    mean = matrix[where].mean(0) if where.sum() >= 20 else np.zeros(matrix.shape[1], np.float32)
                    self.means[kind] = mean
                    centred = matrix[where] - mean
                    matrix[where] = centred / np.maximum(np.linalg.norm(centred, axis=1, keepdims=True), 1e-9)
                self.matrix = matrix
                self.stale = False
                self.loaded_at = time.monotonic()
            return self.ids, self.kinds, self.matrix, self.means

    def _word_ranks(self, terms, joiner):
        """{chunk id: rank} of FTS matches, as typed or failing that with the
        last term as a prefix, so results follow a word still being typed."""
        if not terms:
            return {}
        for prefix in ("", "*"):
            match = joiner.join('"%s"' % t for t in terms) + prefix
            with self.lock:
                rows = self.db.execute(
                    "SELECT rowid FROM fts WHERE fts MATCH ? ORDER BY bm25(fts, 4.0, 1.0) LIMIT 60", (match,)
                ).fetchall()
            if rows:
                break
        return {r[0]: rank for rank, r in enumerate(rows)}

    def search(self, query, limit=30, semantic=True, words=False):
        """Hits by meaning, and with words=True also by the literal words and
        file paths. semantic=False leaves the model out of it."""
        terms = query_terms(query)
        ids, kinds, matrix, means = self._vectors()

        # Passages, pictures and code are ranked apart: they score on different
        # scales against a text query, so one list would bury two of them. Code
        # is also asked for with the model's own code-retrieval prompt.
        by_meaning, by_looks, by_code = {}, {}, {}
        if semantic and len(ids):
            has_code = bool((kinds == CODE).any())
            vectors = self.embedder.embed([QUERY_PROMPT + query] + [CODE_QUERY_PROMPT + query] * has_code)
            for ranks, kind, vector, floor, window in (
                (by_meaning, TEXT, vectors[0], self.cfg["min_similarity"], 0.12),
                (by_looks, IMAGE, vectors[0], self.cfg["min_image_similarity"], 0.05),
                (by_code, CODE, vectors[-1], self.cfg["min_code_similarity"], 0.12),
            ):
                where = np.flatnonzero(kinds == kind)
                if not len(where):
                    continue
                centred = vector - means[kind]
                sims = matrix[where] @ (centred / np.linalg.norm(centred))
                order = np.argsort(-sims)[:60]
                # There is always a nearest neighbour; only ones near the
                # best, and above the floor, count as hits.
                floor = max(floor, sims[order[0]] - window)
                ranks.update((int(ids[where[i]]), rank) for rank, i in enumerate(order) if sims[i] >= floor)

        by_words = self._word_ranks(terms, " AND ") if words else {}
        if words and semantic and not (by_words or by_meaning or by_looks or by_code):
            # Nothing has all the words and nothing means the same: passages
            # with any of the words are better than an empty list. Only then,
            # because one common word of a long question matches almost anything.
            by_words = self._word_ranks(terms, " OR ")

        # Reciprocal rank fusion of the lists. Pictures count for less: their
        # similarity to a text query separates good from bad less sharply.
        scores = {}
        for ranks, weight in ((by_meaning, 1.0), (by_code, 1.0), (by_looks, 0.6), (by_words, 1.0)):
            for chunk_id, rank in ranks.items():
                scores[chunk_id] = scores.get(chunk_id, 0.0) + weight / (60 + rank)

        hits = []
        seen_files = set()
        seen_passages = set()
        for chunk_id in sorted(scores, key=scores.get, reverse=True):
            with self.lock:
                row = self.db.execute(
                    "SELECT f.id, f.path, f.mtime, f.size, f.pages, c.page, c.text, c.kind, c.w0, c.hash "
                    "FROM chunks c JOIN files f ON f.id = c.file_id WHERE c.id=?", (chunk_id,)
                ).fetchone()
            # One row per document, its best passage, and one per passage:
            # copies of a file would otherwise fill the list with one answer.
            if not row or row[0] in seen_files or (row[9] and row[9] in seen_passages):
                continue
            seen_files.add(row[0])
            seen_passages.add(row[9])
            _, path, mtime, size, pages, page, text, kind, w0, _ = row
            directory, name = os.path.split(path)
            excerpt = snippet(text, terms)
            if chunk_id not in by_words:
                why = "looks" if kind == IMAGE else "meaning"
            else:
                why = "words" if "<b>" in excerpt else "name"
            hits.append({
                "chunk": chunk_id,
                "path": path,
                "name": name,
                "dir": "~" + directory[len(HOME):] if directory.startswith(HOME) else directory,
                "ext": name.rsplit(".", 1)[-1].lower() if "." in name else "",
                "page": page,
                "pages": pages,
                "mtime": int(mtime),
                "size": size,
                "line": w0 if kind == CODE else 0,
                "image": kind == IMAGE,
                "why": why,
                "snippet": excerpt,
            })
            if len(hits) >= limit:
                break
        return hits

    def preview(self, chunk_id, query):
        """What the preview pane shows for one hit: a page image with highlight
        rects for a PDF, the picture for an image, the block with line numbers
        for code, a longer excerpt otherwise."""
        terms = query_terms(query)
        with self.lock:
            row = self.db.execute(
                "SELECT f.path, f.mtime, c.page, c.w0, c.w1, c.text, c.kind FROM chunks c "
                "JOIN files f ON f.id = c.file_id "
                "WHERE c.id=?", (chunk_id,)
            ).fetchone()
        if not row:
            return {}
        path, mtime, page, w0, w1, text, kind = row
        if kind == IMAGE:
            width, height = image_size(path)
            return {"image": path, "aspect": height / width, "passage": [], "terms": []}
        if kind == CODE:
            digits = len(str(w1))
            return {"code": "\n".join("%*d  %s" % (digits, w0 + i, line) for i, line in enumerate(text.split("\n")))}
        if not page:
            return {"text": snippet(text, terms, width=1400)}

        key = hashlib.sha1(("%s|%s|%d" % (path, mtime, page)).encode()).hexdigest()[:24]
        render = CACHE / "pages" / (key + ".png")
        if not render.exists():
            render.parent.mkdir(parents=True, exist_ok=True)
            subprocess.run(
                ["pdftoppm", "-f", str(page), "-l", str(page), "-r", "140", "-png", "-singlefile", path,
                 str(render.with_suffix(""))],
                capture_output=True, timeout=60,
            )
        pages = pdf_pages(path, page)
        if not pages or not render.exists():
            return {"text": snippet(text, terms, width=1400)}
        size, words = pages[0]["size"], pages[0]["words"]
        matches = [w for w in words if terms and is_match(re.sub(r"^\W+|\W+$", "", w[0]), terms)]
        return {
            "image": str(render),
            "aspect": size[1] / size[0],
            "passage": line_rects(words[w0:w1], size),
            "terms": [r for w in matches for r in line_rects([w], size)],
        }


# --- Keeping the index current ---------------------------------------------


class Indexer:
    """Queue of paths to (re)index or forget, fed by a reconcile at startup and
    by inotify afterwards, drained by one worker thread."""

    def __init__(self, index, cfg):
        self.index = index
        self.cfg = cfg
        self.roots = [r for r in (os.path.expanduser(r).rstrip("/") for r in cfg["roots"]) if os.path.isdir(r)]
        self.exclude_names = {e for e in cfg["exclude"] if "/" not in e}
        self.exclude_paths = [e.strip("/") for e in cfg["exclude"] if "/" in e]
        self.pending = {}  # insertion-ordered set: the backlog
        self.urgent = {}  # the same for changes seen live, which go first
        self.cond = threading.Condition()
        self.total = 0
        self.done = 0
        self.inotify = None
        self.watches = {}  # watch descriptor -> directory

    # What is indexed: files with a known extension below a root, outside
    # hidden and excluded folders, and, inside a git repository, not ignored.

    def skipped(self, path):
        """Whether a path below a root is hidden or excluded, by its components."""
        root = next((r for r in self.roots if path.startswith(r + "/")), None)
        if root is None:
            return True
        rel = path[len(root) + 1 :]
        return any(p.startswith(".") or p in self.exclude_names for p in rel.split("/")) or any(
            rel == e or rel.startswith(e + "/") for e in self.exclude_paths
        )

    def repository(self, directory):
        """Whether a directory is inside a git work tree, without leaving its root."""
        root = next((r for r in self.roots if (directory + "/").startswith(r + "/")), directory)
        while len(directory) >= len(root):
            if os.path.exists(directory + "/.git"):
                return True
            directory = os.path.dirname(directory)
        return False

    def git(self, directory, *args):
        # Repositories under a home directory include ones that were downloaded.
        # These two settings are how a repository's own config can name a
        # program for git to run, so they are overridden.
        safe = ["-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null"]
        return subprocess.run(["git", *safe, "-C", directory, *args], capture_output=True, timeout=300)

    def git_files(self, directory):
        listing = self.git(directory, "ls-files", "-z", "--cached", "--others", "--exclude-standard")
        return [os.path.join(directory, p) for p in listing.stdout.decode("utf-8", "replace").split("\0") if p]

    def scan(self, top):
        """(files, directories) below a directory: every indexable file, and
        every folder a new one could appear in. Outside a repository that is
        each folder; inside one, each folder holding something git lists."""
        candidates = []
        directories = set()

        def repository(directory):
            for path in self.git_files(directory):
                if not self.skipped(path):
                    candidates.append(path)
                    directories.add(os.path.dirname(path))

        if self.repository(top):
            repository(top)
        else:
            stack = [top]
            while stack:
                directory = stack.pop()
                directories.add(directory)
                try:
                    entries = list(os.scandir(directory))
                except OSError:
                    continue
                for entry in entries:
                    if self.skipped(entry.path):
                        continue
                    if entry.is_dir(follow_symlinks=False):
                        if os.path.exists(entry.path + "/.git"):
                            repository(entry.path)
                        else:
                            stack.append(entry.path)
                    elif entry.is_file(follow_symlinks=False):
                        candidates.append(entry.path)
        files = [p for p in candidates if self.index.kind_of(p) is not None and os.path.isfile(p)]
        return files, directories

    def listing(self, top):
        return self.scan(top)[0]

    def wanted(self, path):
        """The same question for one path, as the watcher needs to ask it."""
        if self.index.kind_of(path) is None or self.skipped(path):
            return False
        directory = os.path.dirname(path)
        if self.repository(directory):
            return self.git(directory, "check-ignore", "-q", path).returncode != 0
        return True

    # The queue.

    def enqueue(self, paths, urgent=False):
        """Queue paths. A file just saved should not wait behind a first index
        of everything, so the watcher's paths are taken before the backlog."""
        queue = self.urgent if urgent else self.pending
        with self.cond:
            for p in paths:
                if p not in self.pending and p not in self.urgent:
                    queue[p] = True
                    self.total += 1
            self.cond.notify()

    def work(self):
        limits = {CODE: self.cfg["max_code_kb"] << 10}
        while True:
            with self.cond:
                while not (self.pending or self.urgent):
                    self.total = self.done = 0
                    self.cond.wait()
                queue = self.urgent or self.pending
                path = next(iter(queue))
                del queue[path]
            try:
                limit = limits.get(self.index.kind_of(path), self.cfg["max_file_mb"] << 20)
                if os.path.isfile(path) and os.path.getsize(path) <= limit and self.wanted(path):
                    self.index.index_file(path)
                else:
                    self.index.remove_file(path)
            except Exception as e:
                log("skipped %s: %s" % (path, e))
            self.done += 1

    def reconcile(self):
        """Bring the index and the watches in line with the disk: what changed
        while nothing was watching, and what the configuration now covers."""
        known = self.index.known_files()
        on_disk = set()
        changed = []
        for root in self.roots:
            files, directories = self.scan(root)
            self.watch_directories(directories)
            for path in files:
                on_disk.add(path)
                try:
                    st = os.stat(path)
                except OSError:
                    continue
                if known.get(path) != (st.st_mtime, st.st_size):
                    changed.append(path)
        self.enqueue(changed + [p for p in known if p not in on_disk])
        log("reconcile: %d to index, %d known, %d directories watched" % (len(changed), len(known), len(self.watches)))

    # Watching. inotify is not recursive: one watch sees one directory. So
    # there is a watch on every directory a file could turn up in (see scan),
    # and on each ancestor up to the root so that a new folder is noticed.
    # Watching everything instead would also cover every node_modules and
    # .git, which on a home directory is most of the watches a user is allowed.

    def watch_directories(self, directories):
        if self.inotify is None:
            return
        from inotify_simple import flags

        mask = flags.CLOSE_WRITE | flags.CREATE | flags.MOVED_TO | flags.MOVED_FROM | flags.DELETE | flags.ONLYDIR
        watched = set(self.watches.values())
        wanted = set()
        for directory in directories:
            while directory not in wanted and any((directory + "/").startswith(r + "/") for r in self.roots):
                wanted.add(directory)
                directory = os.path.dirname(directory)
        for directory in wanted - watched:
            try:
                self.watches[self.inotify.add_watch(directory, mask)] = directory
            except OSError as e:
                log("cannot watch %s: %s" % (directory, e))

    def watch(self):
        from inotify_simple import INotify, flags

        self.inotify = INotify()
        self.reconcile()
        while True:
            # Blocks until something happens; then gathers what follows for a
            # second, since a save or a checkout is rarely one event.
            events = self.inotify.read(read_delay=1000)
            paths = []
            known = None
            for event in events:
                directory = self.watches.get(event.wd)
                if directory is None:
                    continue
                if event.mask & flags.IGNORED:  # the directory itself is gone
                    del self.watches[event.wd]
                    continue
                path = os.path.join(directory, event.name)
                if not event.mask & flags.ISDIR:
                    # work() indexes it if it is there and wanted, and forgets it otherwise.
                    if self.index.kind_of(path) is not None:
                        paths.append(path)
                elif event.mask & (flags.CREATE | flags.MOVED_TO):
                    # A new folder: watch it and what is in it, unless git
                    # ignores it. It is watched even while empty, since files
                    # usually arrive after the folder does.
                    ignored = self.repository(directory) and self.git(directory, "check-ignore", "-q", path).returncode == 0
                    if not self.skipped(path) and not ignored:
                        new, directories = self.scan(path)
                        inside = (d for d, _, _ in os.walk(path) if not self.skipped(d))
                        self.watch_directories(directories | set(inside))
                        paths.extend(new)
                else:
                    # A folder moved away or deleted takes its files with it.
                    known = known or self.index.known_files()
                    paths.extend(p for p in known if p.startswith(path + "/"))
            self.enqueue(paths, urgent=True)

    def start(self):
        for target in (self.work, self.watch):
            threading.Thread(target=target, daemon=True).start()


# --- Socket -----------------------------------------------------------------


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        for line in self.rfile:
            req = {}
            try:
                req = json.loads(line)
                if req.get("op") == "search" and req.get("words") and not self.server.embedder.loaded():
                    # The words need no model: answer with those now, and
                    # again in full once it has loaded.
                    hits = self.server.index.search(req["q"], semantic=False, words=True)
                    self.reply(req, {"hits": hits, "partial": True})
                resp = self.server.dispatch(req)
            except Exception as e:
                resp = {"error": str(e)}
            self.reply(req, resp)

    def reply(self, req, resp):
        resp.update(id=req.get("id"), op=req.get("op"), status=self.server.status())
        self.wfile.write((json.dumps(resp) + "\n").encode())
        self.wfile.flush()


class Server(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True

    def __init__(self, index, indexer, embedder):
        self.index, self.indexer, self.embedder = index, indexer, embedder
        super().__init__(str(SOCKET), Handler)

    def status(self):
        s = self.index.stats()
        s.update(done=self.indexer.done, total=self.indexer.total, loaded=self.embedder.loaded())
        return s

    def dispatch(self, req):
        op = req.get("op")
        if op == "search":
            return {"hits": self.index.search(req["q"], words=bool(req.get("words")))}
        if op == "preview":
            return {"preview": self.index.preview(req["chunk"], req.get("q", ""))}
        if op == "warm":
            # Load the model while the user is still typing their first query.
            threading.Thread(target=self.embedder.embed, args=(["warm"],), daemon=True).start()
        elif op == "rescan":
            threading.Thread(target=self.indexer.reconcile, daemon=True).start()
        return {}


def main():
    cfg = dict(DEFAULTS)
    if CONFIG.exists():
        cfg.update(tomllib.loads(CONFIG.read_text()))

    DATA.mkdir(parents=True, exist_ok=True)
    db = sqlite3.connect(DATA / "index.db", check_same_thread=False)
    db.execute("PRAGMA journal_mode=WAL")

    embedder = LlamaEmbedder(cfg)
    image_embedder = LlamaEmbedder(cfg, vision=True)
    index = Index(db, embedder, image_embedder, cfg)
    index.reset_if_model_changed(os.path.basename(cfg["model"]))
    indexer = Indexer(index, cfg)

    os.umask(0o077)
    SOCKET.unlink(missing_ok=True)
    server = Server(index, indexer, embedder)
    indexer.start()
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    try:
        server.serve_forever()
    finally:
        embedder.stop()
        image_embedder.stop()
        SOCKET.unlink(missing_ok=True)


if __name__ == "__main__":
    main()
